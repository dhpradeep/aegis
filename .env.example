# Aegis configuration. Copy to .env and adjust. All values have sane defaults.

# --- Core ---
# SQLite by default; point at Postgres/MySQL with an async driver if you prefer.
DATABASE_URL=sqlite+aiosqlite:///./data/aegis.db

# Agent workspaces MUST live outside any git repo / your project, otherwise
# agent runs inherit that project's CLAUDE.md and memory.
WORKSPACE_ROOT=~/.aegis/workspaces

# --- Admin dashboard ---
# CHANGE BOTH before exposing the dashboard anywhere.
ADMIN_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-long-random-string

# --- Runtime limits ---
MAX_CONCURRENT_RUNS=3
RUN_TIMEOUT_S=1800
DEFAULT_RPM=30
DEFAULT_DAILY_COST_USD=10.0
WORKSPACE_QUOTA_MB=512
WORKSPACE_TTL_DAYS=7

# Fallback model for the OpenAI-compatible endpoint when a request omits `model`.
DEFAULT_MODEL=claude-sonnet-5

# Apply Alembic migrations on startup (recommended for the persistent DB).
RUN_MIGRATIONS_ON_STARTUP=true

# Fetch the model catalog live from Anthropic using your subscription login.
MODELS_LIVE_FETCH=true

# Host port the Docker Compose service is published on
AEGIS_PORT=8000
